#[summary("siphash: SipHash-2-4 and SipHash-1-3 with 64-bit and 128-bit output, keyed by 128 bits, ported from the Rust crate siphasher 1.0.4")]
mod siphash {
    #[summary("A 128-bit SipHash value: h1 is the low half, h2 the high half")]
    struct Hash128 { h1: u64, h2: u64 }

    #[summary("An incremental SipHash computation: the key, the rounds, whether the output is 128 bits, the number of bytes written so far (modulo 2^64), the state, and the 0 to 7 bytes of the last incomplete word (little-endian in tail, ntail of them)")]
    struct Hasher { k0: u64, k1: u64, rounds: Rounds, wide: bool, length: u64, state: State, tail: u64, ntail: usize }

    #[summary("The number of compression rounds per message word and at the end: SipHash-1-3 or SipHash-2-4")]
    enum Rounds { Sip13, Sip24 }

    #[summary("The four 64-bit words of the SipHash state")]
    struct State { v0: u64, v1: u64, v2: u64, v3: u64 }

    #[summary("The state after absorbing the message word m")]
    spec fn absorb(s: State, m: u64, r: Rounds) -> State {
        let t: State = c_rounds(State { v0: s.v0, v1: s.v1, v2: s.v2, v3: s.v3 ^ m }, r);
        State { v0: t.v0 ^ m, v1: t.v1, v2: t.v2, v3: t.v3 }
    }

    #[summary("Absorbs the message word m")]
    #[effects(pure)]
    #[uses(absorb)]
    fn absorb_word(s: &mut State, m: u64, r: Rounds) -> ()
        ensures *s == absorb(*old(s), m, r),
    {
        s.v3 = s.v3 ^ m;
        compress_c(s, r);
        s.v0 = s.v0 ^ m;
    }

    spec fn c_rounds(s: State, r: Rounds) -> State {
        match r {
            Rounds::Sip13 => sipround(s),
            Rounds::Sip24 => sipround(sipround(s)),
        }
    }

    #[effects(pure)]
    #[uses(c_rounds)]
    fn compress_c(s: &mut State, r: Rounds) -> ()
        ensures *s == c_rounds(*old(s), r),
    {
        match r {
            Rounds::Sip13 => round(s),
            Rounds::Sip24 => { round(s); round(s); },
        }
    }

    #[effects(pure)]
    #[uses(d_rounds)]
    fn compress_d(s: &mut State, r: Rounds) -> ()
        ensures *s == d_rounds(*old(s), r),
    {
        match r {
            Rounds::Sip13 => { round(s); round(s); round(s); },
            Rounds::Sip24 => { round(s); round(s); round(s); round(s); },
        }
    }

    #[summary("m is a followed by b")]
    spec fn concat(a: &[u8], b: &[u8], m: &[u8]) -> bool {
        m.len() == a.len() + b.len() && (forall|i: usize| i < a.len() ==> #[trigger] m[i] == a[i]) && (forall|j: usize| j < b.len() ==> #[trigger] b[j] == m[a.len() + j])
    }

    spec fn d_rounds(s: State, r: Rounds) -> State {
        match r {
            Rounds::Sip13 => sipround(sipround(sipround(s))),
            Rounds::Sip24 => sipround(sipround(sipround(sipround(s)))),
        }
    }

    #[summary("Finishes a 64-bit hasher: the SipHash value of the bytes written")]
    #[effects(pure)]
    #[uses(fold, last, place, pw, result)]
    fn finish(h: &Hasher) -> (r: u64)
        requires ok(*h),
        ensures r == result(*h),
    {
        let mut s: State = h.state;
        let b: u64 = ((h.length & 255) << 56) + h.tail;
        absorb_word(&mut s, b, h.rounds);
        s.v2 = s.v2 ^ 255;
        compress_d(&mut s, h.rounds);
        s.v0 ^ s.v1 ^ s.v2 ^ s.v3
    }

    #[summary("Finishes a 128-bit hasher: the SipHash-128 value of the bytes written")]
    #[effects(pure)]
    #[uses(fold, last, place, pw, result128)]
    fn finish128(h: &Hasher) -> (r: Hash128)
        requires ok(*h),
        ensures r == result128(*h),
    {
        let mut s: State = h.state;
        let b: u64 = ((h.length & 255) << 56) + h.tail;
        absorb_word(&mut s, b, h.rounds);
        s.v2 = s.v2 ^ 238;
        compress_d(&mut s, h.rounds);
        let h1: u64 = s.v0 ^ s.v1 ^ s.v2 ^ s.v3;
        s.v1 = s.v1 ^ 221;
        compress_d(&mut s, h.rounds);
        Hash128 { h1: h1, h2: s.v0 ^ s.v1 ^ s.v2 ^ s.v3 }
    }

    spec fn fold(s: State) -> u64 {
        s.v0 ^ s.v1 ^ s.v2 ^ s.v3
    }

    #[summary("The 64-bit SipHash of msg under the key k0, k1, in one call")]
    #[effects(pure)]
    fn hash(k0: u64, k1: u64, r: Rounds, msg: &[u8]) -> (x: u64)
        ensures x == result(pushes(initial(k0, k1, r, false), msg, msg.len())),
    {
        let mut h: Hasher = new_with_keys(k0, k1, r);
        write(&mut h, msg);
        finish(&h)
    }

    #[summary("The 128-bit SipHash of msg under the key k0, k1, in one call")]
    #[effects(pure)]
    fn hash128(k0: u64, k1: u64, r: Rounds, msg: &[u8]) -> (x: Hash128)
        ensures x == result128(pushes(initial(k0, k1, r, true), msg, msg.len())),
    {
        let mut h: Hasher = new128_with_keys(k0, k1, r);
        write(&mut h, msg);
        finish128(&h)
    }

    #[summary("The initial hasher for the key k0, k1")]
    spec fn initial(k0: u64, k1: u64, r: Rounds, wide: bool) -> Hasher {
        Hasher { k0: k0, k1: k1, rounds: r, wide: wide, length: 0, state: State { v0: k0 ^ 0x736f6d6570736575, v1: k1 ^ (if wide { 0x646f72616e646f83 } else { 0x646f72616e646f6d }), v2: k0 ^ 0x6c7967656e657261, v3: k1 ^ 0x7465646279746573 }, tail: 0, ntail: 0 }
    }

    #[summary("The key of h as 16 bytes, little-endian (the origin's key)")]
    #[effects(pure)]
    fn key(h: &Hasher) -> [u8; 16] {
        let a: [u8; 8] = h.k0.to_le_bytes();
        let b: [u8; 8] = h.k1.to_le_bytes();
        [a[0], a[1], a[2], a[3], a[4], a[5], a[6], a[7], b[0], b[1], b[2], b[3], b[4], b[5], b[6], b[7]]
    }

    #[summary("The two key words of a 16-byte key, little-endian (the origin's new_with_key)")]
    spec fn key0(key: [u8; 16]) -> u64 {
        u64::from_le_bytes([key[0], key[1], key[2], key[3], key[4], key[5], key[6], key[7]])
    }

    spec fn key1(key: [u8; 16]) -> u64 {
        u64::from_le_bytes([key[8], key[9], key[10], key[11], key[12], key[13], key[14], key[15]])
    }

    #[summary("The state after the last word (the length byte and the tail) and the first finalization")]
    spec fn last(h: Hasher, x: u64) -> State {
        let hi: u64 = h.length % 256;
        let t: State = absorb(h.state, place(hi, 7) + h.tail, h.rounds);
        d_rounds(State { v0: t.v0, v1: t.v1, v2: t.v2 ^ x, v3: t.v3 }, h.rounds)
    }

    #[summary("A 128-bit hasher for a 16-byte key")]
    #[effects(pure)]
    #[uses(key0, key1)]
    fn new128_with_key(key: [u8; 16], r: Rounds) -> (h: Hasher)
        ensures h == initial(key0(key), key1(key), r, true), ok(h),
    {
        let k0: u64 = u64::from_le_bytes([key[0], key[1], key[2], key[3], key[4], key[5], key[6], key[7]]);
        let k1: u64 = u64::from_le_bytes([key[8], key[9], key[10], key[11], key[12], key[13], key[14], key[15]]);
        new128_with_keys(k0, k1, r)
    }

    #[summary("A hasher for the key k0, k1 with 128-bit output")]
    #[effects(pure)]
    #[uses(pw)]
    fn new128_with_keys(k0: u64, k1: u64, r: Rounds) -> (h: Hasher)
        ensures h == initial(k0, k1, r, true), ok(h),
    {
        Hasher { k0: k0, k1: k1, rounds: r, wide: true, length: 0, state: State { v0: k0 ^ 0x736f6d6570736575, v1: k1 ^ 0x646f72616e646f83, v2: k0 ^ 0x6c7967656e657261, v3: k1 ^ 0x7465646279746573 }, tail: 0, ntail: 0 }
    }

    #[summary("A 64-bit hasher for a 16-byte key")]
    #[effects(pure)]
    #[uses(key0, key1)]
    fn new_with_key(key: [u8; 16], r: Rounds) -> (h: Hasher)
        ensures h == initial(key0(key), key1(key), r, false), ok(h),
    {
        let k0: u64 = u64::from_le_bytes([key[0], key[1], key[2], key[3], key[4], key[5], key[6], key[7]]);
        let k1: u64 = u64::from_le_bytes([key[8], key[9], key[10], key[11], key[12], key[13], key[14], key[15]]);
        new_with_keys(k0, k1, r)
    }

    #[summary("A hasher for the key k0, k1 with 64-bit output")]
    #[effects(pure)]
    #[uses(pw)]
    fn new_with_keys(k0: u64, k1: u64, r: Rounds) -> (h: Hasher)
        ensures h == initial(k0, k1, r, false), ok(h),
    {
        Hasher { k0: k0, k1: k1, rounds: r, wide: false, length: 0, state: State { v0: k0 ^ 0x736f6d6570736575, v1: k1 ^ 0x646f72616e646f6d, v2: k0 ^ 0x6c7967656e657261, v3: k1 ^ 0x7465646279746573 }, tail: 0, ntail: 0 }
    }

    #[summary("The tail holds ntail bytes, fewer than 8")]
    spec fn ok(h: Hasher) -> bool {
        h.ntail < 8 && h.tail < pw(h.ntail)
    }

    #[summary("The byte value x placed at byte n of a word (x * 256^n), for n < 8")]
    spec fn place(x: u64, n: usize) -> u64 {
        if n == 0 {
            x
        } else if n == 1 {
            x * 256
        } else if n == 2 {
            x * 65536
        } else if n == 3 {
            x * 16777216
        } else if n == 4 {
            x * 4294967296
        } else if n == 5 {
            x * 1099511627776
        } else if n == 6 {
            x * 281474976710656
        } else {
            x * 72057594037927936
        }
    }

    #[summary("The byte b placed at byte n of a word")]
    #[effects(pure)]
    #[uses(place, pw)]
    fn place_byte(b: u8, n: usize) -> (r: u64)
        requires n < 8,
        ensures r == place(b as u64, n), r < pw(n + 1) || n == 7,
    {
        let x: u64 = b as u64;
        if n == 0 {
            x
        } else if n == 1 {
            x << 8
        } else if n == 2 {
            x << 16
        } else if n == 3 {
            x << 24
        } else if n == 4 {
            x << 32
        } else if n == 5 {
            x << 40
        } else if n == 6 {
            x << 48
        } else {
            x << 56
        }
    }

    proof fn prefix_same(h: Hasher, a: &[u8], b: &[u8], m: &[u8], n: usize)
        requires concat(a, b, m), n <= a.len(),
        ensures pushes(h, a, n) == pushes(h, m, n),
        decreases n,
    {
        if n > 0 {
            prefix_same(h, a, b, m, n - 1);
        }
    }

    #[summary("The hasher after the byte b: it goes into the tail, and the eighth byte completes a word that is absorbed")]
    spec fn push(h: Hasher, b: u8) -> Hasher {
        let x: u64 = b as u64;
        if h.ntail == 7 {
            Hasher { k0: h.k0, k1: h.k1, rounds: h.rounds, wide: h.wide, length: h.length.wrapping_add(1), state: absorb(h.state, h.tail + place(x, 7), h.rounds), tail: 0, ntail: 0 }
        } else {
            Hasher { k0: h.k0, k1: h.k1, rounds: h.rounds, wide: h.wide, length: h.length.wrapping_add(1), state: h.state, tail: h.tail + place(x, h.ntail), ntail: h.ntail + 1 }
        }
    }

    #[summary("The hasher after the first n bytes of m")]
    spec fn pushes(h: Hasher, m: &[u8], n: usize) -> Hasher
        decreases n,
    {
        if n == 0 {
            h
        } else {
            push(pushes(h, m, n - 1), m[n - 1])
        }
    }

    #[summary("256 to the power n, for n < 8")]
    spec fn pw(n: usize) -> u64 {
        if n == 0 {
            1
        } else if n == 1 {
            256
        } else if n == 2 {
            65536
        } else if n == 3 {
            16777216
        } else if n == 4 {
            4294967296
        } else if n == 5 {
            1099511627776
        } else if n == 6 {
            281474976710656
        } else {
            72057594037927936
        }
    }

    #[summary("The 64-bit SipHash value of what h has absorbed")]
    spec fn result(h: Hasher) -> u64 {
        fold(last(h, 255))
    }

    #[summary("The 128-bit SipHash value of what h has absorbed")]
    spec fn result128(h: Hasher) -> Hash128 {
        let s: State = last(h, 238);
        Hash128 { h1: fold(s), h2: fold(d_rounds(State { v0: s.v0, v1: s.v1 ^ 221, v2: s.v2, v3: s.v3 }, h.rounds)) }
    }

    #[effects(pure)]
    #[uses(sipround)]
    fn round(s: &mut State) -> ()
        ensures *s == sipround(*old(s)),
    {
        s.v0 = s.v0.wrapping_add(s.v1);
        s.v1 = s.v1.rotate_left(13);
        s.v1 = s.v1 ^ s.v0;
        s.v0 = s.v0.rotate_left(32);
        s.v2 = s.v2.wrapping_add(s.v3);
        s.v3 = s.v3.rotate_left(16);
        s.v3 = s.v3 ^ s.v2;
        s.v0 = s.v0.wrapping_add(s.v3);
        s.v3 = s.v3.rotate_left(21);
        s.v3 = s.v3 ^ s.v0;
        s.v2 = s.v2.wrapping_add(s.v1);
        s.v1 = s.v1.rotate_left(17);
        s.v1 = s.v1 ^ s.v2;
        s.v2 = s.v2.rotate_left(32);
    }

    #[summary("One SipRound")]
    spec fn sipround(s: State) -> State {
        let a0: u64 = s.v0.wrapping_add(s.v1);
        let b1: u64 = s.v1.rotate_left(13) ^ a0;
        let c0: u64 = a0.rotate_left(32);
        let a2: u64 = s.v2.wrapping_add(s.v3);
        let b3: u64 = s.v3.rotate_left(16) ^ a2;
        let d0: u64 = c0.wrapping_add(b3);
        let e3: u64 = b3.rotate_left(21) ^ d0;
        let d2: u64 = a2.wrapping_add(b1);
        let e1: u64 = b1.rotate_left(17) ^ d2;
        State { v0: d0, v1: e1, v2: d2.rotate_left(32), v3: e3 }
    }

    #[summary("Streaming equals one-shot: if x is the hasher after writing a, then writing b to x leaves the hasher that writing m, the concatenation of a and b, leaves; so finish gives the one-shot hash of m")]
    proof fn streaming(h: Hasher, x: Hasher, a: &[u8], b: &[u8], m: &[u8])
        requires concat(a, b, m), x == pushes(h, a, a.len()),
        ensures pushes(x, b, b.len()) == pushes(h, m, m.len()),
    {
        prefix_same(h, a, b, m, a.len());
        suffix_same(x, h, a, b, m, b.len());
    }

    proof fn suffix_same(x: Hasher, h: Hasher, a: &[u8], b: &[u8], m: &[u8], n: usize)
        requires concat(a, b, m), n <= b.len(), x == pushes(h, m, a.len()),
        ensures pushes(x, b, n) == pushes(h, m, a.len() + n),
        decreases n,
    {
        if n > 0 {
            suffix_same(x, h, a, b, m, n - 1);
        }
    }

    #[summary("Writes the bytes of msg: the same as writing them one by one")]
    #[effects(pure)]
    fn write(h: &mut Hasher, msg: &[u8]) -> ()
        requires ok(*h),
        ensures *h == pushes(*old(h), msg, msg.len()), ok(*h),
    {
        for i in 0..msg.len()
            invariant *h == pushes(*old(h), msg, i), ok(*h),
        {
            write_byte(h, msg[i]);
        }
    }

    #[summary("Writes one byte")]
    #[effects(pure)]
    #[uses(place, push, pw)]
    fn write_byte(h: &mut Hasher, b: u8) -> ()
        requires ok(*h),
        ensures *h == push(*old(h), b), ok(*h),
    {
        let n: usize = h.ntail;
        h.tail = h.tail + place_byte(b, n);
        h.length = h.length.wrapping_add(1);
        if n == 7 {
            let t: u64 = h.tail;
            let r: Rounds = h.rounds;
            absorb_word(&mut h.state, t, r);
            h.tail = 0;
            h.ntail = 0;
        } else {
            h.ntail = n + 1;
        }
    }
}
